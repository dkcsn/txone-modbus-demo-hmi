{
  "name": "txone-modbus-demo-hmi",
  "version": "0.1.0",
  "description": "Cross-platform TXOne HMI for the CPU fan and windmill Modbus TCP demos",
  "main": "src/main/index.cjs",
  "author": "TXOne Networks",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test \"test/*.test.cjs\"",
    "check": "node --check src/main/index.cjs && node --check src/main/connection-manager.cjs && node --check src/main/device-profiles.cjs && node --check src/main/discovery.cjs && node --check src/preload.cjs && node --check src/renderer/app.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --arm64 --publish never",
    "dist:win": "npm prune --omit=optional && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "modbus-serial": "^8.0.23"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.txone.modbus-demo-hmi",
    "productName": "TXOne Modbus Demo HMI",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
